<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Prevent duplicate assembly attributes (SDK + Functions Worker SDK both generate) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <!-- Exclude SDK-generated assembly attribute files in obj (keep Properties/AssemblyInfo.cs) -->
  <Target Name="RemoveGeneratedAssemblyInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_AutoGenAssemblyFiles Include="@(Compile)" Condition="($([System.String]::Copy('%(Compile.Identity)').Contains('AssemblyInfo.cs')) or $([System.String]::Copy('%(Compile.Identity)').Contains('AssemblyAttributes.cs'))) and $([System.String]::Copy('%(Compile.Identity)').Contains('\obj\'))" />
      <Compile Remove="@(_AutoGenAssemblyFiles)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Remove="BlobToCosmosFunction.AppHost\**" />
    <EmbeddedResource Remove="BlobToCosmosFunction.AppHost\**" />
    <None Remove="BlobToCosmosFunction.AppHost\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="HOST-JSON-INFO.md" />
    <None Remove="README-AZURE-COSMOSDB.md" />
    <None Remove="README-PHONE-NUMBERS.md" />
    <None Remove="README.md" />
    <None Remove="setup-cosmosdb-network-access.ps1" />
    <None Remove="start-emulators.ps1" />
    <None Remove="stop-emulators.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" Version="6.8.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.2.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.45.0" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.12.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
